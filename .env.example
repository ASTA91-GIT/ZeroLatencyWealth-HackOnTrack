# ==========================================
# ZeroLatency Wealth — Environment Variables
# ==========================================
# Copy this file to .env and populate with appropriate values.
# NEVER commit .env or actual production secrets to source control.

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Frontend API Target (Vite dev server proxies /api to this address)
VITE_API_URL=http://127.0.0.1:8000

# Database Configuration (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./backend/zerolatency.db

# Authentication Security (Use a cryptographically secure random string in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Configuration (Optional: Deterministic fallback engine is active if unset)
LLM_PROVIDER=none # Options: 'openai', 'gemini', 'anthropic', 'none'
LLM_API_KEY=
LLM_MODEL=

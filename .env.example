# ============================================================
# ZERO LATENCY WEALTH — PRODUCTION CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit .env or actual production secrets to source control.

# Application Environment ('development' | 'staging' | 'production')
APP_ENV=development
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./backend/zerolatency.db
# Production PostgreSQL Example:
# DATABASE_URL=postgresql://zerolatency_user:strongpassword123@postgres:5432/zerolatency_db

# Cryptographic Authentication Secrets (Argon2id + JWT)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-in-production-64char
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# Local AI Configuration (OLLAMA ONLY — NO EXTERNAL AI API KEYS NEEDED)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
MAX_CHAT_MESSAGES=10
MAX_CONTEXT_TOKENS=2048

# Email Service (SMTP)
# Note: If unset, safe development logger outbox mechanism is active.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@your-domain.mailgun.org
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=ZeroLatency Wealth <noreply@zerolatency.invest>

# Email Verification (Set to 'false' for hackathon evaluation ease; 'true' for strict production)
REQUIRE_EMAIL_VERIFICATION=false

# Market Data Service Abstraction ('demo' | 'real')
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=

# Paper Trading / Simulation Engine
PAPER_TRADING_ENABLED=true
